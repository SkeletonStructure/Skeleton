# Copy to .env for local development. Never commit the real .env.
APP_URL=http://localhost:3000
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info
LOG_FORMAT=json

# Required. Use a least-privilege PostgreSQL role.
DATABASE_URL=postgres://skeleton:skeleton@localhost:5432/skeleton
DATABASE_SSL=false
