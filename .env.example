# Copy to .env for local development. Never commit the real .env.
# Precedence: process environment > .env.local > .env > skeleton.config.ts > defaults.

APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
HOST=0.0.0.0
TRUST_PROXY=false

# Required. Use a least-privilege PostgreSQL role.
DATABASE_URL=postgres://skeleton:skeleton@localhost:5432/skeleton
DATABASE_SSL=false
DB_POOL_MAX=10

# Must be true in production behind HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# Comma-separated exact origins, e.g. http://localhost:5173,https://app.example.com
CORS_ORIGINS=

LOG_LEVEL=info
LOG_FORMAT=pretty
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
