{
  "name": "@skeletonstructure/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./api": {
      "types": "./dist/src/api/index.d.ts",
      "import": "./dist/src/api/index.js",
      "default": "./dist/src/api/index.js"
    },
    "./config": {
      "types": "./dist/src/config/index.d.ts",
      "import": "./dist/src/config/index.js",
      "default": "./dist/src/config/index.js"
    },
    "./database": {
      "types": "./dist/src/database/index.d.ts",
      "import": "./dist/src/database/index.js",
      "default": "./dist/src/database/index.js"
    },
    "./modules": {
      "types": "./dist/src/modules/index.d.ts",
      "import": "./dist/src/modules/index.js",
      "default": "./dist/src/modules/index.js"
    },
    "./security": {
      "types": "./dist/src/security/index.d.ts",
      "import": "./dist/src/security/index.js",
      "default": "./dist/src/security/index.js"
    }
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.2"
  }
