# Copy to .env for local development. Never commit a real .env.
DATABASE_URL=postgres://skeleton:skeleton@localhost:5432/skeleton
APP_URL=http://localhost:5173
PORT=3000
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
NODE_ENV=development

# Demo-only login created by `pnpm --filter @skeletonstructure/demo-ecommerce db:seed`.
# Override these locally if desired; never use real credentials.
DEMO_USER_EMAIL=demo@skeletonstructure.local
DEMO_USER_PASSWORD=demo-password-123
