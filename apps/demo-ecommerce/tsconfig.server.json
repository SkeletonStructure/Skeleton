{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.server.tsbuildinfo"
  },
  "include": [
    "drizzle.config.ts",
    "skeleton.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "modules/cart/src/**/*.ts",
    "modules/cart/tests/**/*.ts",
    "src/server/**/*.ts",
    "tests/**/*.ts"
  ],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/app-composition" },
    { "path": "../../packages/module-auth" },
    { "path": "../../packages/module-catalog" },
    { "path": "../../packages/module-inventory" },
    { "path": "../../packages/module-orders" },
    { "path": "../../packages/module-products" },
    { "path": "../../packages/module-users" },
    { "path": "../../packages/sdk" }
  ]
}
