{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!pnpm-lock.yaml",
      "!docs/config/reference.md",
      "!openapi/openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
