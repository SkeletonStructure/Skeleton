{
  "name": "skeletonstructure-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run packages/sdk/tests/contract.test.ts",
    "sdk:generate": "node scripts/generate-sdk.mjs",
    "sdk:check": "node scripts/check-sdk.mjs",
    "config:docs": "tsc -b packages/core && node scripts/generate-config-reference.mjs",
    "skeleton": "node scripts/skeleton.mjs",
    "start": "tsc -b && node scripts/skeleton.mjs start",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:users": "drizzle-kit generate --config drizzle.users.config.ts",
    "db:generate:auth": "drizzle-kit generate --config drizzle.auth.config.ts",
    "db:generate:catalog": "drizzle-kit generate --config drizzle.catalog.config.ts",
    "db:generate:products": "drizzle-kit generate --config drizzle.products.config.ts",
    "db:generate:inventory": "drizzle-kit generate --config drizzle.inventory.config.ts",
    "db:generate:orders": "drizzle-kit generate --config drizzle.orders.config.ts",
    "db:migrate": "tsc -b && node scripts/migrate-modules.mjs",
    "auth:cleanup": "tsc -b && node scripts/cleanup-sessions.mjs",
    "openapi:generate": "tsc -b && node scripts/generate-openapi.mjs",
    "openapi:check": "tsc -b && node scripts/check-openapi.mjs",
    "test:integration": "vitest run packages/core/tests/database/integration.test.ts",
    "demo:ecommerce:api": "pnpm --filter @skeletonstructure/demo-ecommerce api",
    "demo:ecommerce:dev": "pnpm --filter @skeletonstructure/demo-ecommerce dev",
    "demo:ecommerce:migrate": "pnpm --filter @skeletonstructure/demo-ecommerce db:migrate",
    "demo:ecommerce:seed": "pnpm --filter @skeletonstructure/demo-ecommerce db:seed",
    "demo:ecommerce:openapi:generate": "pnpm --filter @skeletonstructure/demo-ecommerce openapi:generate",
    "demo:ecommerce:openapi:check": "pnpm --filter @skeletonstructure/demo-ecommerce openapi:check",
    "demo:ecommerce:client:generate": "pnpm --filter @skeletonstructure/demo-ecommerce client:generate",
    "demo:ecommerce:client:check": "pnpm --filter @skeletonstructure/demo-ecommerce client:check",
    "demo:ecommerce:test:integration": "pnpm --filter @skeletonstructure/demo-ecommerce test:integration",
    "demo:ecommerce:test:e2e": "pnpm --filter @skeletonstructure/demo-ecommerce test:e2e",
    "demo:ecommerce:verify": "pnpm demo:ecommerce:openapi:check && pnpm demo:ecommerce:client:check && pnpm demo:ecommerce:test:integration && pnpm demo:ecommerce:test:e2e",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:contract && pnpm sdk:check && pnpm demo:ecommerce:openapi:check && pnpm demo:ecommerce:client:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@skeletonstructure/app-composition": "workspace:*",
    "@skeletonstructure/core": "workspace:*",
    "@skeletonstructure/module-auth": "workspace:*",
    "@skeletonstructure/module-catalog": "workspace:*",
    "@skeletonstructure/module-inventory": "workspace:*",
    "@skeletonstructure/module-orders": "workspace:*",
    "@skeletonstructure/module-products": "workspace:*",
    "@skeletonstructure/module-users": "workspace:*",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
